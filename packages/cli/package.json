{
  "name": "openaeo",
  "version": "0.1.0",
  "description": "CLI for auditing AI answer-engine readiness and open-web attribution signals.",
  "type": "module",
  "bin": {
    "openaeo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@openaeo/audit": "0.1.0",
    "@openaeo/crawler": "0.1.0",
    "commander": "^15.0.0"
  }
}
